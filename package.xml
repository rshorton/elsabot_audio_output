<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>elsabot_audio_output</name>
  <version>0.0.1</version>
  <description>Audio output processor for Elsabot robot</description>
  <maintainer email="none@none.com">Scott Horton</maintainer>
  <license>MIT</license>

  <depend>elsabot_audio_output_interfaces</depend>

  <exec_depend>python3-pyaudio</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-soundfile</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
